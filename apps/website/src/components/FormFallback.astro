---
import type { HTMLAttributes } from 'astro/types';
import { fallbackLinks } from '../forms/config';
import { useTranslations, type Locale } from '../i18n';
import { fallback, fallbackList } from './FormPage.css';

const Tag = 'div';

// Куда написать, когда форма недоступна: список один и тот же для страницы без скрипта и для сбоя отправки.
interface Props extends HTMLAttributes<typeof Tag> {
  /** Язык страницы: от него зависят подписи ссылок */
  locale: Locale;
  /** Первая строка; скрипт страницы подменяет её по причине сбоя */
  message: string;
}

const { locale, message, class: className, ...attrs } = Astro.props;
const t = useTranslations(locale);
const links = fallbackLinks
  .filter((link) => link.href !== '')
  .map((link) => ({ href: link.href, label: link.labelKey ? t(link.labelKey) : (link.handle ?? link.href) }));
---

<Tag class:list={[fallback, className]} {...attrs}>
  <p data-fallback-text>{message}</p>
  <ul class={fallbackList} aria-label={t('forms.fallback.list')}>
    {links.map((link) => <li><a href={link.href} target="_blank" rel="noopener noreferrer">{link.label}</a></li>)}
  </ul>
</Tag>
