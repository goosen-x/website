---
import type { GetStaticPaths } from 'astro';
import CallToAction from '@moscowcss/ui/components/CallToAction';
import RegistrationDialog from '@moscowcss/ui/components/RegistrationDialog';
import BaseLayout from '../../layouts/BaseLayout.astro';
import AboutSection from '../../sections/AboutSection.astro';
import HeroSection from '../../sections/HeroSection.astro';
import ProgramSection from '../../sections/ProgramSection.astro';
import PartnerSection from '../../sections/PartnerSection.astro';
import SchoolPartnerSection from '../../sections/SchoolPartnerSection.astro';
import FAQSection from '../../sections/FAQSection.astro';
import OrganizersSection from '../../sections/OrganizersSection.astro';
import { loadCatalog, localeOf, upcomingEvent } from '../../content/catalog';
import { heroCtaAt } from '../../content/cta';
import { buildNow } from '../../content/now';
import { organizersByStatus } from '../../content/organizers';
import { registrationTabsOf } from '../../content/registration';
import { defaultLocale, localizePath, locales, useTranslations, type Locale } from '../../i18n';

// Маршрут `[...locale]`: у языка по умолчанию параметр пустой, поэтому ru живёт в `/`, en в `/en/`.
export const getStaticPaths = (() =>
  locales.map((locale) => ({
    params: { locale: locale === defaultLocale ? undefined : locale },
    props: { locale },
  }))) satisfies GetStaticPaths;

const { locale } = Astro.props as { locale: Locale };
const t = useTranslations(locale);

const now = buildNow();

// Каталог проверяется на сборке: битая ссылка или разошедшийся перевод роняют build.
const catalog = await loadCatalog();
const inLocale = <T extends { id: string }>(entries: T[]): T[] =>
  entries.filter((entry) => localeOf(entry) === locale);

const page = inLocale(catalog.pages).find((entry) => entry.id === `${locale}/index`);
if (!page) throw new Error(`Missing page content: pages/${locale}/index.md`);

const events = inLocale(catalog.events);
const featured = upcomingEvent(events, now);
// Окно с формами регистрации — только у ближайшего митапа, пока он не прошёл.
const registrationTabs =
  featured && !featured.past
    ? registrationTabsOf(featured.event, {
        networkly: t('registration.networkly'),
        networklyFrame: t('registration.networklyFrame'),
        networklyFallback: t('registration.networklyFallback'),
        timepad: t('registration.timepad'),
        timepadFallback: t('registration.timepadFallback'),
      })
    : [];
const registrationDialogId = 'registration-dialog';
// Плавающая кнопка: регистрация до закрытия за 2 дня, вечером митапа — вопрос спикеру (content/cta.ts).
// Решение на момент сборки; скрипт внизу пересчитывает его по часам браузера.
const upcoming = featured && !featured.past ? featured.event : undefined;
const hasRegistration = Boolean(upcoming?.data.registrationUrl);
const heroCta = upcoming ? heroCtaAt(upcoming.data.date, now, hasRegistration) : null;
const ctaStartsAt = upcoming?.data.date.toISOString();
const partner = featured?.event.data.partner
  ? inLocale(catalog.partners).find((entry) => entry.id === `${locale}/${featured.event.data.partner}`)
  : undefined;

const organizers = organizersByStatus(inLocale(catalog.organizers), 'current');

const alternates = locales.map((code) => ({ locale: code, path: localizePath(code) }));
---

<BaseLayout
  title={page.data.title}
  description={page.data.description}
  lang={locale}
  alternates={alternates}
>
  <main id="main" tabindex="-1">
    {featured && <HeroSection event={featured.event} locale={locale} past={featured.past} />}
    {
      featured && (
        <ProgramSection
          event={featured.event}
          talks={inLocale(catalog.talks)}
          speakers={inLocale(catalog.speakers)}
          locale={locale}
          questionTag={page.data.questionTag}
        />
      )
    }
    {
      partner && featured && (partner.data.look === 'school21' ? (
        <SchoolPartnerSection partner={partner} event={featured.event} locale={locale} />
      ) : (
        <PartnerSection partner={partner} event={featured.event} locale={locale} />
      ))
    }
    <FAQSection entries={inLocale(catalog.faq).filter((entry) => !entry.data.draft)} locale={locale} />
    <OrganizersSection entries={organizers} locale={locale} />
    <AboutSection page={page} locale={locale} />
    {
      upcoming?.data.registrationUrl && (
        <CallToAction
          href={upcoming.data.registrationUrl}
          aria-label={t('hero.registerLabel')}
          data-registration-open={registrationTabs.length > 0 ? registrationDialogId : undefined}
          data-hero-cta="register"
          data-starts-at={ctaStartsAt}
          data-has-registration={String(hasRegistration)}
          hidden={heroCta !== 'register'}
        >
          {t('hero.register')}
        </CallToAction>
      )
    }
    {
      upcoming && (
        <CallToAction
          href={localizePath(locale, 'question')}
          aria-label={t('hero.questionLabel')}
          data-hero-cta="question"
          data-starts-at={ctaStartsAt}
          data-has-registration={String(hasRegistration)}
          hidden={heroCta !== 'question'}
        >
          {t('hero.question')}
        </CallToAction>
      )
    }
    {
      registrationTabs.length > 0 && (
        <RegistrationDialog
          id={registrationDialogId}
          heading={t('registration.title')}
          closeLabel={t('registration.close')}
          tabsLabel={t('registration.tabs')}
          loadingLabel={t('registration.loading')}
          failedLabel={t('registration.failed')}
          tabs={registrationTabs}
        />
      )
    }
  </main>
</BaseLayout>

<script>
  import { heroCtaAt } from '../../content/cta';

  // Сайт собирается при пуше, а окна регистрации и вопросов — по часам: пересчитываем на месте и раз в минуту.
  const ctas = document.querySelectorAll<HTMLElement>('[data-hero-cta]');
  const update = () => {
    const now = new Date();
    for (const cta of ctas) {
      const startsAt = new Date(cta.dataset['startsAt'] ?? '');
      if (Number.isNaN(startsAt.getTime())) continue;
      cta.hidden = heroCtaAt(startsAt, now, cta.dataset['hasRegistration'] === 'true') !== cta.dataset['heroCta'];
    }
  };
  if (ctas.length > 0) {
    update();
    setInterval(update, 60_000);
  }
</script>
